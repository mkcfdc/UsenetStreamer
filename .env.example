# Bootstrap only. Any key set here locks that field in the UI
# (process env always wins over SQLite). Leave a key unset to
# manage it from http://host:8000/configure.

# Public URL Stremio uses to reach the addon.
ADDON_BASE_URL=http://192.168.0.215:7000
ADDON_SHARED_SECRET=

# Inside Compose use service DNS, not the LAN IP.
REDIS_URL=redis://redis:6379
ADDON_INTERNAL_URL=http://usenetstreamer:7000
# InfiniDysk (service name stays `nzbdav` on the compose network).
NZBDAV_URL=http://nzbdav:3000
NZBDAV_WEBDAV_URL=http://nzbdav:3000
NZBDAV_API_KEY=
NZBDAV_WEBDAV_USER=admin
NZBDAV_WEBDAV_PASS=

# Optional. Leave blank unless you use them.
# PROWLARR_URL=http://prowlarr:9696
# PROWLARR_API_KEY=
# NZBHYDRA_URL=http://nzbhydra:5076
# NZBHYDRA_API_KEY=
# NZB_CHECK_URL=https://nzbcheck.filmwhisper.dev
# NZB_CHECK_API_KEY=
